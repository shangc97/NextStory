# Copy to .env.local and use the Firebase Console Web app firebaseConfig values.
# These identify the client project; access is controlled by Auth + Firestore rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Shared project book data and read rules are deployed.
# For another project, import books and deploy rules before enabling.
EXPO_PUBLIC_FIRESTORE_BOOKS_ENABLED=true

# Shared project like rules are deployed; set false for legacy swipe-only mode.
EXPO_PUBLIC_FIRESTORE_LIKES_ENABLED=true
