rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'preferences', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.preferences is map
        && request.resource.data.preferences.keys().hasOnly(['genres', 'authors'])
        && request.resource.data.preferences.genres is list
        && request.resource.data.preferences.genres.size() <= 20
        && request.resource.data.preferences.authors is list
        && request.resource.data.preferences.authors.size() <= 50
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/users/$(uid)) && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/users/$(uid)) && request.resource.data.createdAt == resource.data.createdAt));
      match /savedBooks/{bookId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['bookId', 'createdAt'])
          && request.resource.data.bookId == bookId
          && request.resource.data.createdAt == request.time;
      }
      match /swipes/{bookId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['bookId', 'direction', 'updatedAt'])
          && request.resource.data.bookId == bookId
          && request.resource.data.direction in ['like', 'skip']
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /like/{likeId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Deterministic IDs prevent duplicate likes for the same reader/book.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'bookId', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && (!exists(/databases/$(database)/documents/like/$(likeId))
          || resource.data.userId == request.auth.uid)
        && request.resource.data.bookId is string
        && request.resource.data.bookId.size() > 0
        && request.resource.data.bookId.size() <= 200
        && likeId == request.auth.uid + '_' + request.resource.data.bookId
        && request.resource.data.updatedAt == request.time;
      // Deleting an absent document is harmless and supports first-time skips.
      allow delete: if signedIn()
        && (!exists(/databases/$(database)/documents/like/$(likeId))
          || resource.data.userId == request.auth.uid);
    }
    match /book/{bookId} {
      allow read: if signedIn();
      // Shared catalogue is maintained by trusted administrative tools.
      allow write: if false;
    }
    match /books/{bookId} {
      allow read: if signedIn();
      // Shared catalogue is maintained by trusted administrative tools.
      allow write: if false;
    }
    match /books/{bookId}/reviews/{uid} {
      allow read: if signedIn();
      allow delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['rating', 'content', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }
  }
}
